    "tailwindcss": "4.1.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@tanstack/react-router-devtools": "1.132.51",
    "@tanstack/router-plugin": "1.132.51",
    "@types/node": "24.6.0",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.0.4",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.4",
